generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model course {
  id        Int     @id @default(autoincrement())
  thai_name String? @db.VarChar(255)
  eng_name  String? @db.VarChar(255)
}

model department {
  id         Int     @id @default(autoincrement())
  thai_name  String? @db.VarChar(255)
  eng_name   String? @db.VarChar(255)
  faculty_id Int?
  course_id  Int?
}

model faculty {
  id        Int     @id @default(autoincrement())
  thai_name String? @db.VarChar(255)
  eng_name  String? @db.VarChar(255)
}

model other_subject {
  id               Int     @id @default(autoincrement())
  subject_id       Int?
  other_subject_id Int?
  status           String? @db.VarChar(255)
}

model semester {
  id        Int     @id @default(autoincrement())
  thai_name String? @db.VarChar(255)
  eng_name  String? @db.VarChar(255)
}

model subject {
  id                Int                @id @default(autoincrement())
  thai_name         String?            @db.VarChar(255)
  eng_name          String?            @db.VarChar(255)
  detail            String?            @db.VarChar(255)
  credit            Int?
  group_id          Int?
  semester_id       Int?
  subject_embedding subject_embedding?
}

model subject_department {
  id            Int  @id @default(autoincrement())
  department_id Int?
  subject_id    Int?
}

model subject_embedding {
  id         Int                    @id @default(autoincrement())
  subject_id Int                    @unique
  content    String
  embedding  Unsupported("vector")?
  created_at DateTime               @default(now()) @db.Timestamptz(6)
  updated_at DateTime               @default(now()) @db.Timestamptz(6)
  subject    subject                @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([embedding])
}

model subject_group {
  id        Int     @id @default(autoincrement())
  thai_name String? @db.VarChar(255)
  eng_name  String? @db.VarChar(255)
}
