generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model course {
  id             Int              @id @default(autoincrement())
  thai_name      String?          @db.VarChar(255)
  eng_name       String?          @db.VarChar(255)
  department_id  Int?
  department     department?      @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_department")
  course_subject course_subject[]
}

model department {
  id         Int      @id @default(autoincrement())
  thai_name  String?  @db.VarChar(255)
  eng_name   String?  @db.VarChar(255)
  faculty_id Int?
  course     course[]
  faculty    faculty? @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_department_faculty")
}

model faculty {
  id         Int          @id @default(autoincrement())
  thai_name  String?      @db.VarChar(255)
  eng_name   String?      @db.VarChar(255)
  department department[]
}

model require_subject {
  id                                              Int      @id @default(autoincrement())
  subject_id                                      Int?
  require_subject_id                              Int?
  required_subject                                subject? @relation("require_subject_required", fields: [require_subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_other_subject_related_subject")
  subject                                         subject? @relation("require_subject_subject", fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_other_subject_subject")
}

model subject {
  id                                                    Int                @id @default(autoincrement())
  subject_code                                          String?            @db.VarChar(255)
  thai_name                                             String?            @db.VarChar(255)
  eng_name                                              String?            @db.VarChar(255)
  detail                                                String?            @db.VarChar(255)
  credit                                                Int?
  group_id                                              Int?
  course_subject                                        course_subject[]
  required_by                                           require_subject[]  @relation("require_subject_required")
  require_subjects                                      require_subject[]  @relation("require_subject_subject")
  subject_group                                         subject_group?     @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_subject_group")
  subject_embedding                                     subject_embedding?
}

model subject_embedding {
  id         Int                    @id @default(autoincrement())
  subject_id Int                    @unique
  content    String
  embedding  Unsupported("vector")?
  created_at DateTime               @default(now()) @db.Timestamptz(6)
  updated_at DateTime               @default(now()) @db.Timestamptz(6)
  subject    subject                @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subject_embedding_subject")

  @@index([embedding])
}

model subject_group {
  id        Int       @id @default(autoincrement())
  thai_name String?   @db.VarChar(255)
  eng_name  String?   @db.VarChar(255)
  subject   subject[]
}

model course_subject {
  id         Int      @id @default(autoincrement())
  course_id  Int?
  subject_id Int?
  year       Int?
  semester   Int?
  course     course?  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_subject_course")
  subject    subject? @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_subject_subject")
}
